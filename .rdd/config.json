{
  "schema_version": 1,
  "requirements": "requirements/requirements.md",
  "limits": {
    "max_tasks": 500,
    "max_phases": 40,
    "max_attempts": 3,
    "lease_seconds": 3600,
    "max_spec_words": 20000,
    "max_packet_characters": 32000
  },
  "github": {
    "remote": "origin",
    "required_checks": [
      "verify"
    ],
    "require_approval": false,
    "completion": "ready"
  },
  "protected_prefixes": [
    "requirements/",
    "docs/specs/",
    "docs/decisions/",
    "contracts/",
    "gen/",
    ".agents/",
    ".codex/",
    ".github/",
    "tools/rdd/",
    "tools/proto-codegen/",
    ".rdd/",
    "tests/harness/"
  ],
  "protected_files": [
    "AGENTS.md",
    "rdd",
    "rdd.cmd",
    "rdd.ps1",
    "buf.yaml",
    "buf.lock",
    "buf.gen.yaml",
    "rust-toolchain.toml"
  ]
}
