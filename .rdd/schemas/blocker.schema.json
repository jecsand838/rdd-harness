{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdd:schema:blocker:v1",
  "title": "RDD blocker v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kind": {
      "type": "string",
      "enum": [
        "specification",
        "planning",
        "closure",
        "environment",
        "authorization",
        "budget",
        "review"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "resolved": {
      "type": "boolean"
    },
    "escape": {
      "type": "object",
      "properties": {
        "severity": {
          "$ref": "#/$defs/nonempty_text"
        },
        "detected_stage": {
          "$ref": "#/$defs/nonempty_text"
        },
        "origin_stage": {
          "$ref": "#/$defs/nonempty_text"
        },
        "source_commit": {
          "$ref": "#/$defs/nonempty_text"
        },
        "source_digest": {
          "$ref": "#/$defs/nonempty_text"
        },
        "spec_digest": {
          "$ref": "#/$defs/nonempty_text"
        },
        "plan_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "affected": {
          "type": "object",
          "properties": {
            "requirements": {
              "$ref": "#/$defs/unique_strings"
            },
            "elements": {
              "$ref": "#/$defs/unique_strings"
            },
            "tasks": {
              "$ref": "#/$defs/unique_strings"
            }
          },
          "required": [
            "requirements",
            "elements",
            "tasks"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "$ref": "#/$defs/unique_strings"
        },
        "diagnostic": {
          "$ref": "#/$defs/nonempty_text"
        }
      },
      "required": [
        "severity",
        "detected_stage",
        "origin_stage",
        "source_commit",
        "source_digest",
        "spec_digest",
        "plan_digest",
        "affected",
        "evidence",
        "diagnostic"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "reason",
    "created_at",
    "resolved"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonempty_text": {
      "type": "string",
      "minLength": 1
    },
    "unique_strings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
