{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdd:schema:blocker:v1",
  "title": "RDD blocker v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kind": {
      "type": "string",
      "enum": [
        "specification",
        "planning",
        "closure",
        "environment",
        "authorization",
        "budget",
        "review"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "resolved": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "reason",
    "created_at",
    "resolved"
  ],
  "additionalProperties": false
}
