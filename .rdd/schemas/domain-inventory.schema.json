{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "requirements_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "behaviors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "module",
          "requirements",
          "behaviors",
          "invariants"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supporting_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "adapter",
              "infrastructure",
              "presentation",
              "orchestration",
              "shared_types",
              "build"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "behaviors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "module",
          "kind",
          "requirements",
          "behaviors"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "consumer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "call",
              "type_only"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "behaviors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "consumer",
          "provider",
          "kind",
          "requirements",
          "behaviors"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "requirements_digest",
    "domains",
    "supporting_modules",
    "interactions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdd:schema:domain-inventory:v1",
  "title": "RDD accepted S1 domain inventory"
}
