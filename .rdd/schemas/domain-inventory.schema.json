{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "requirements_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/identity"
          },
          "module": {
            "$ref": "#/$defs/identity"
          },
          "requirements": {
            "$ref": "#/$defs/references"
          },
          "behaviors": {
            "$ref": "#/$defs/rows",
            "minItems": 1
          },
          "invariants": {
            "$ref": "#/$defs/rows"
          }
        },
        "required": [
          "id",
          "module",
          "requirements",
          "behaviors",
          "invariants"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supporting_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/identity"
          },
          "module": {
            "$ref": "#/$defs/identity"
          },
          "kind": {
            "enum": [
              "adapter",
              "infrastructure",
              "presentation",
              "orchestration",
              "shared_types",
              "build"
            ]
          },
          "requirements": {
            "$ref": "#/$defs/references"
          },
          "behaviors": {
            "$ref": "#/$defs/rows"
          }
        },
        "required": [
          "id",
          "module",
          "kind",
          "requirements",
          "behaviors"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/identity"
          },
          "consumer": {
            "$ref": "#/$defs/identity"
          },
          "provider": {
            "$ref": "#/$defs/identity"
          },
          "kind": {
            "enum": [
              "call",
              "type_only",
              "composition"
            ]
          },
          "requirements": {
            "$ref": "#/$defs/references"
          },
          "behaviors": {
            "$ref": "#/$defs/optional_identities"
          }
        },
        "required": [
          "id",
          "consumer",
          "provider",
          "kind",
          "requirements",
          "behaviors"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "requirements_digest",
    "domains",
    "supporting_modules",
    "interactions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdd:schema:domain-inventory:v2",
  "title": "RDD accepted S1 domain inventory",
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "optional_identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/identity"
          },
          "requirements": {
            "$ref": "#/$defs/references"
          },
          "behavior": {
            "enum": [
              "positive",
              "negative",
              "support"
            ]
          }
        },
        "required": [
          "id",
          "requirements",
          "behavior"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
