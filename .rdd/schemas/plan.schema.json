{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdd:schema:plan:v3",
  "title": "RDD plan v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]{2,3}$"
          },
          "goal": {
            "$ref": "#/$defs/explanation"
          },
          "tasks": {
            "$ref": "#/$defs/ids"
          },
          "checks": {
            "$ref": "#/$defs/ids"
          },
          "requirements_closed": {
            "$ref": "#/$defs/optional_ids"
          },
          "deliverables": {
            "$ref": "#/$defs/paths"
          },
          "independent_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/explanation"
            },
            "minItems": 1,
            "uniqueItems": false
          }
        },
        "required": [
          "id",
          "goal",
          "tasks",
          "checks",
          "requirements_closed",
          "deliverables",
          "independent_evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]{3,6}$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 240
          },
          "phase": {
            "type": "string",
            "pattern": "^P[0-9]{2,3}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "tests",
              "deletion",
              "modification",
              "addition",
              "documentation"
            ]
          },
          "requirements": {
            "$ref": "#/$defs/ids"
          },
          "specifications": {
            "$ref": "#/$defs/paths"
          },
          "depends_on": {
            "$ref": "#/$defs/optional_ids"
          },
          "writes": {
            "$ref": "#/$defs/paths"
          },
          "checks": {
            "$ref": "#/$defs/optional_ids"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/explanation"
            },
            "minItems": 1,
            "uniqueItems": false
          },
          "scope": {
            "type": "string",
            "enum": [
              "small",
              "large"
            ]
          },
          "reuse": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "capability_missing": {
                    "$ref": "#/$defs/explanation"
                  },
                  "candidates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "$ref": "#/$defs/reference"
                        },
                        "reason": {
                          "$ref": "#/$defs/explanation"
                        }
                      },
                      "required": [
                        "path",
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "uniqueItems": false
                  },
                  "why_not_extend": {
                    "$ref": "#/$defs/explanation"
                  },
                  "duplication_check": {
                    "$ref": "#/$defs/explanation"
                  }
                },
                "required": [
                  "capability_missing",
                  "candidates",
                  "why_not_extend",
                  "duplication_check"
                ],
                "additionalProperties": false
              }
            ]
          },
          "solution_elements": {
            "$ref": "#/$defs/ids"
          },
          "scenarios": {
            "$ref": "#/$defs/ids"
          },
          "requires": {
            "$ref": "#/$defs/optional_ids"
          },
          "produces": {
            "$ref": "#/$defs/optional_ids"
          },
          "bootstrap_resources": {
            "$ref": "#/$defs/optional_ids"
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^A[0-9]{2,4}$"
                },
                "path": {
                  "$ref": "#/$defs/reference"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "inline",
                    "sidecar"
                  ]
                },
                "placement": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "append",
                        "before",
                        "after"
                      ]
                    },
                    "context": {
                      "$ref": "#/$defs/nullable_string"
                    }
                  },
                  "required": [
                    "kind",
                    "context"
                  ],
                  "additionalProperties": false
                },
                "primary": {
                  "type": "boolean"
                },
                "instructions": {
                  "$ref": "#/$defs/explanation"
                }
              },
              "required": [
                "id",
                "path",
                "mode",
                "placement",
                "primary",
                "instructions"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "objective": {
            "$ref": "#/$defs/explanation"
          }
        },
        "required": [
          "id",
          "title",
          "phase",
          "category",
          "requirements",
          "specifications",
          "depends_on",
          "writes",
          "checks",
          "acceptance",
          "scope",
          "reuse",
          "solution_elements",
          "scenarios",
          "requires",
          "produces",
          "bootstrap_resources",
          "sites",
          "objective"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "verticals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V[0-9]{2,4}$"
          },
          "goal": {
            "$ref": "#/$defs/explanation"
          },
          "tasks": {
            "$ref": "#/$defs/ids"
          }
        },
        "required": [
          "id",
          "goal",
          "tasks"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "target_paths": {
      "$ref": "#/$defs/paths"
    },
    "shells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/reference"
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 20000
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "author_sessions": {
      "$ref": "#/$defs/ids"
    },
    "element_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "$ref": "#/$defs/reference_id"
          },
          "tasks": {
            "$ref": "#/$defs/optional_ids"
          },
          "checks": {
            "$ref": "#/$defs/ids"
          },
          "baseline_evidence": {
            "$ref": "#/$defs/nullable_string"
          }
        },
        "required": [
          "element",
          "tasks",
          "checks",
          "baseline_evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "resource_producers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "$ref": "#/$defs/reference_id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "baseline",
              "task",
              "external"
            ]
          },
          "task": {
            "$ref": "#/$defs/nullable_string"
          },
          "checks": {
            "$ref": "#/$defs/optional_ids"
          }
        },
        "required": [
          "resource",
          "kind",
          "task",
          "checks"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "resource_uses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "$ref": "#/$defs/reference_id"
          },
          "consumer_kind": {
            "type": "string",
            "enum": [
              "preparation",
              "task_red",
              "task_completion",
              "phase",
              "project"
            ]
          },
          "consumer": {
            "$ref": "#/$defs/nullable_string"
          }
        },
        "required": [
          "resource",
          "consumer_kind",
          "consumer"
        ],
        "additionalProperties": false
      }
    },
    "boundary_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "first_phase": {
            "type": "string",
            "pattern": "^P[0-9]{2,3}$"
          },
          "checks": {
            "$ref": "#/$defs/proof_ids"
          },
          "provider_tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "consumer_tasks": {
            "$ref": "#/$defs/proof_ids"
          },
          "adapter_tasks": {
            "$ref": "#/$defs/proof_ids"
          },
          "verification_tasks": {
            "$ref": "#/$defs/proof_ids"
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "interaction": {
            "$ref": "#/$defs/reference_id"
          },
          "consumer": {
            "$ref": "#/$defs/reference_id"
          },
          "provider": {
            "$ref": "#/$defs/reference_id"
          },
          "export": {
            "$ref": "#/$defs/reference"
          }
        },
        "required": [
          "interaction",
          "consumer",
          "provider",
          "first_phase",
          "checks",
          "provider_tasks",
          "consumer_tasks",
          "verification_tasks"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "operation",
              "adapter_tasks"
            ],
            "properties": {
              "export": {
                "maxLength": 0
              },
              "provider_tasks": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "export"
            ],
            "properties": {
              "operation": {
                "maxLength": 0
              },
              "adapter_tasks": {
                "maxItems": 0
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "type_import_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "first_phase": {
            "type": "string",
            "pattern": "^P[0-9]{2,3}$"
          },
          "checks": {
            "$ref": "#/$defs/proof_ids"
          },
          "consumer_tasks": {
            "$ref": "#/$defs/proof_ids"
          },
          "verification_tasks": {
            "$ref": "#/$defs/proof_ids"
          },
          "interaction": {
            "$ref": "#/$defs/reference_id"
          },
          "consumer": {
            "$ref": "#/$defs/reference_id"
          },
          "provider": {
            "$ref": "#/$defs/reference_id"
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "interaction",
          "consumer",
          "provider",
          "first_phase",
          "checks",
          "consumer_tasks",
          "verification_tasks",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "spec_digest",
    "phases",
    "tasks",
    "verticals",
    "target_paths",
    "shells",
    "author_sessions",
    "element_coverage",
    "resource_producers",
    "resource_uses",
    "boundary_proofs",
    "type_import_proofs"
  ],
  "additionalProperties": false,
  "$defs": {
    "ids": {
      "$ref": "#/$defs/optional_ids",
      "minItems": 1
    },
    "optional_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference_id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "proof_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
