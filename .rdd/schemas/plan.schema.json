{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdd:schema:plan:v1",
  "title": "RDD plan v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]{2,3}$"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requirements_closed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "independent_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "minItems": 1,
            "uniqueItems": false
          }
        },
        "required": [
          "id",
          "goal",
          "tasks",
          "checks",
          "requirements_closed",
          "deliverables",
          "independent_evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]{3,6}$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 240
          },
          "phase": {
            "type": "string",
            "pattern": "^P[0-9]{2,3}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "tests",
              "deletion",
              "modification",
              "addition",
              "documentation"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "specifications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "minItems": 1,
            "uniqueItems": false
          },
          "scope": {
            "type": "string",
            "enum": [
              "small",
              "large"
            ]
          },
          "anchor": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "mode": {
                "type": "string",
                "enum": [
                  "inline",
                  "sidecar"
                ]
              }
            },
            "required": [
              "path",
              "mode"
            ],
            "additionalProperties": false
          },
          "reuse": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "capability_missing": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "candidates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        }
                      },
                      "required": [
                        "path",
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "uniqueItems": false
                  },
                  "why_not_extend": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "duplication_check": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "capability_missing",
                  "candidates",
                  "why_not_extend",
                  "duplication_check"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "phase",
          "category",
          "requirements",
          "specifications",
          "depends_on",
          "writes",
          "checks",
          "acceptance",
          "scope",
          "anchor",
          "reuse"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "verticals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "goal",
          "tasks"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "target_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "shells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 20000
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": false
    }
  },
  "required": [
    "schema_version",
    "spec_digest",
    "phases",
    "tasks",
    "verticals",
    "target_paths",
    "shells"
  ],
  "additionalProperties": false
}
