{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDD stage review v2",
  "type": "object",
  "properties": {
    "reviewer": {
      "$ref": "#/$defs/reference"
    },
    "model": {
      "$ref": "#/$defs/reference"
    },
    "session_id": {
      "$ref": "#/$defs/reference"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "changes_requested"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 8000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/reference"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "high",
              "medium",
              "low",
              "note"
            ]
          },
          "requirements": {
            "$ref": "#/$defs/references"
          },
          "tasks": {
            "$ref": "#/$defs/references"
          },
          "path": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "severity",
          "requirements",
          "tasks",
          "path",
          "message",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "schema_version": {
      "const": 2
    },
    "stage": {
      "enum": [
        "specification",
        "plan",
        "preparation"
      ]
    },
    "perspective": {
      "enum": [
        "semantic",
        "execution"
      ]
    },
    "evidence_ids": {
      "$ref": "#/$defs/candidate_references"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/$defs/candidate_text"
        },
        "run_id": {
          "$ref": "#/$defs/candidate_text"
        },
        "source_commit": {
          "$ref": "#/$defs/candidate_text"
        },
        "source_digest": {
          "$ref": "#/$defs/candidate_text"
        },
        "spec_digest": {
          "$ref": "#/$defs/candidate_text"
        },
        "digest": {
          "$ref": "#/$defs/candidate_text"
        },
        "plan_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stage",
        "run_id",
        "source_commit",
        "source_digest",
        "spec_digest",
        "digest",
        "plan_digest"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "requirements": {
          "$ref": "#/$defs/candidate_references"
        },
        "elements": {
          "$ref": "#/$defs/candidate_references"
        },
        "scenarios": {
          "$ref": "#/$defs/candidate_references"
        },
        "checks": {
          "$ref": "#/$defs/candidate_references"
        },
        "tasks": {
          "$ref": "#/$defs/candidate_references"
        }
      },
      "required": [
        "requirements",
        "elements",
        "scenarios",
        "checks",
        "tasks"
      ],
      "additionalProperties": false
    },
    "kind": {
      "const": "final"
    },
    "review_cursor": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "reviewer",
    "model",
    "session_id",
    "decision",
    "summary",
    "findings",
    "schema_version",
    "stage",
    "perspective",
    "evidence_ids",
    "candidate",
    "coverage",
    "kind",
    "review_cursor"
  ],
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "candidate_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "candidate_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate_text"
      },
      "uniqueItems": true
    }
  }
}
