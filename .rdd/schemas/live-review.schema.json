{
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 8000
    },
    "source_commit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "high",
              "medium",
              "low",
              "note"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "path": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "severity",
          "requirements",
          "tasks",
          "path",
          "message",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "live"
    },
    "stage": {
      "enum": [
        "specification",
        "preparation",
        "implementation"
      ]
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirements_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "spec_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "finding_id",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "model",
    "reviewer",
    "session_id",
    "summary",
    "source_commit",
    "source_digest",
    "findings",
    "schema_version",
    "kind",
    "stage",
    "phase",
    "requirements_digest",
    "spec_digest",
    "plan_digest",
    "resolutions"
  ],
  "additionalProperties": false
}
