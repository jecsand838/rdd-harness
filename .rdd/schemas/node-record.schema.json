{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "node": {
      "type": "string",
      "pattern": "^[SP][0-8]$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "input_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node",
    "attempt",
    "session_id",
    "input_digest",
    "outputs",
    "evidence_ids"
  ],
  "additionalProperties": false
}
