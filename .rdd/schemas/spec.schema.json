{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdd:schema:spec:v1",
  "title": "RDD spec v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "requirements_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "regenerate",
        "amend"
      ]
    },
    "parent_spec_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4000
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "contract_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "generated_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "contract_check_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "project_check_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "contract_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "owns_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "requirements",
          "contract_paths",
          "owns_paths",
          "depends_on"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "golden",
              "negative",
              "boundary",
              "failure",
              "benchmark",
              "architecture",
              "accessibility",
              "security",
              "manual"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "requirements",
          "kind",
          "description",
          "expected",
          "check_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "benchmark",
              "contract",
              "architecture",
              "lint",
              "build",
              "security",
              "manual"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "any",
                "linux",
                "windows",
                "macos"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "red_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "statistic": {
                  "type": "string",
                  "enum": [
                    "p95",
                    "p50",
                    "max",
                    "min",
                    "mean"
                  ]
                },
                "limit": {
                  "type": "number"
                },
                "comparison": {
                  "type": "string",
                  "enum": [
                    "lte",
                    "gte"
                  ]
                },
                "minimum_samples": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "name",
                "statistic",
                "limit",
                "comparison",
                "minimum_samples",
                "unit"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "host_profile": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "argv",
          "cwd",
          "timeout_seconds",
          "platforms",
          "red_pattern",
          "metrics",
          "host_profile"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "requirement_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "specifications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "requirement",
          "specifications",
          "scenarios"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "amendment": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        }
      },
      "required": [
        "requirements",
        "paths",
        "rationale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "requirements_digest",
    "mode",
    "parent_spec_digest",
    "change_summary",
    "documents",
    "decisions",
    "contract_files",
    "generated_files",
    "contract_check_ids",
    "project_check_ids",
    "modules",
    "scenarios",
    "checks",
    "requirement_map",
    "amendment"
  ],
  "additionalProperties": false
}
