{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdd:schema:spec:v3",
  "title": "RDD spec v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "$ref": "#/$defs/reference"
    },
    "requirements_digest": {
      "$ref": "#/$defs/sha256"
    },
    "mode": {
      "type": "string",
      "enum": [
        "regenerate",
        "amend"
      ]
    },
    "parent_spec_digest": {
      "$ref": "#/$defs/nullable_text"
    },
    "change_summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4000
    },
    "documents": {
      "$ref": "#/$defs/texts"
    },
    "decisions": {
      "$ref": "#/$defs/optional_texts"
    },
    "contract_files": {
      "$ref": "#/$defs/texts"
    },
    "generated_files": {
      "$ref": "#/$defs/texts"
    },
    "contract_check_ids": {
      "$ref": "#/$defs/references"
    },
    "project_check_ids": {
      "$ref": "#/$defs/references"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/reference"
          },
          "requirements": {
            "$ref": "#/$defs/references"
          },
          "contract_paths": {
            "$ref": "#/$defs/optional_texts"
          },
          "owns_paths": {
            "$ref": "#/$defs/texts"
          },
          "depends_on": {
            "$ref": "#/$defs/optional_references"
          },
          "provided_services": {
            "$ref": "#/$defs/optional_texts"
          },
          "consumed_operations": {
            "$ref": "#/$defs/optional_texts"
          },
          "generated_paths": {
            "$ref": "#/$defs/optional_texts"
          },
          "adapter_error_specs": {
            "$ref": "#/$defs/optional_texts"
          },
          "qualification_checks": {
            "type": "object",
            "properties": {
              "provider": {
                "$ref": "#/$defs/optional_texts"
              },
              "consumer": {
                "$ref": "#/$defs/optional_texts"
              },
              "negative_signature": {
                "$ref": "#/$defs/optional_texts"
              },
              "dependency_direction": {
                "$ref": "#/$defs/optional_texts"
              },
              "compatibility": {
                "$ref": "#/$defs/optional_texts"
              }
            },
            "required": [
              "provider",
              "consumer",
              "negative_signature",
              "dependency_direction",
              "compatibility"
            ],
            "additionalProperties": false
          },
          "implementation_checks": {
            "type": "object",
            "properties": {
              "provider": {
                "$ref": "#/$defs/optional_texts"
              },
              "consumer": {
                "$ref": "#/$defs/optional_texts"
              },
              "dependency_direction": {
                "$ref": "#/$defs/optional_texts"
              },
              "compatibility": {
                "$ref": "#/$defs/optional_texts"
              },
              "semantics": {
                "$ref": "#/$defs/optional_texts"
              }
            },
            "required": [
              "provider",
              "consumer",
              "dependency_direction",
              "compatibility",
              "semantics"
            ],
            "additionalProperties": false
          },
          "contract_package": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
          },
          "provided_types": {
            "$ref": "#/$defs/optional_texts"
          },
          "consumed_types": {
            "$ref": "#/$defs/optional_texts"
          },
          "public_exports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "$ref": "#/$defs/text"
                },
                "path": {
                  "$ref": "#/$defs/text"
                },
                "kind": {
                  "enum": [
                    "operation",
                    "type",
                    "service",
                    "construction",
                    "wiring"
                  ]
                },
                "binding": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "specifications": {
                  "$ref": "#/$defs/texts"
                }
              },
              "required": [
                "symbol",
                "path",
                "kind",
                "binding",
                "specifications"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "requirements",
          "contract_paths",
          "owns_paths",
          "depends_on",
          "provided_services",
          "consumed_operations",
          "generated_paths",
          "adapter_error_specs",
          "qualification_checks",
          "implementation_checks",
          "contract_package",
          "provided_types",
          "consumed_types",
          "public_exports"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/reference"
          },
          "requirements": {
            "$ref": "#/$defs/references"
          },
          "kind": {
            "type": "string",
            "enum": [
              "golden",
              "negative",
              "boundary",
              "failure",
              "benchmark",
              "architecture",
              "accessibility",
              "security",
              "manual"
            ]
          },
          "description": {
            "$ref": "#/$defs/explanation"
          },
          "expected": {
            "$ref": "#/$defs/explanation"
          },
          "check_ids": {
            "$ref": "#/$defs/references"
          },
          "solution_elements": {
            "$ref": "#/$defs/references"
          },
          "preconditions": {
            "$ref": "#/$defs/explanation"
          },
          "fixture": {
            "$ref": "#/$defs/explanation"
          },
          "stimulus": {
            "$ref": "#/$defs/explanation"
          },
          "verification_method": {
            "$ref": "#/$defs/explanation"
          }
        },
        "required": [
          "id",
          "requirements",
          "kind",
          "description",
          "expected",
          "check_ids",
          "solution_elements",
          "preconditions",
          "fixture",
          "stimulus",
          "verification_method"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/reference"
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "benchmark",
              "contract",
              "architecture",
              "lint",
              "build",
              "security",
              "manual",
              "readiness"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "cwd": {
            "$ref": "#/$defs/text"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "any",
                "linux",
                "windows",
                "macos"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "red_pattern": {
            "$ref": "#/$defs/nullable_text"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/reference"
                },
                "statistic": {
                  "type": "string",
                  "enum": [
                    "p95",
                    "p50",
                    "max",
                    "min",
                    "mean"
                  ]
                },
                "limit": {
                  "type": "number"
                },
                "comparison": {
                  "type": "string",
                  "enum": [
                    "lte",
                    "gte"
                  ]
                },
                "minimum_samples": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit": {
                  "$ref": "#/$defs/reference"
                }
              },
              "required": [
                "name",
                "statistic",
                "limit",
                "comparison",
                "minimum_samples",
                "unit"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "host_profile": {
            "$ref": "#/$defs/nullable_text"
          },
          "environments": {
            "$ref": "#/$defs/references"
          },
          "requires": {
            "$ref": "#/$defs/optional_references"
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            },
            "uniqueItems": true
          },
          "results_path": {
            "$ref": "#/$defs/nullable_text"
          }
        },
        "required": [
          "id",
          "kind",
          "argv",
          "cwd",
          "timeout_seconds",
          "platforms",
          "red_pattern",
          "metrics",
          "host_profile",
          "environments",
          "requires",
          "scenario_ids",
          "results_path"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "requirement_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "$ref": "#/$defs/reference"
          },
          "specifications": {
            "$ref": "#/$defs/texts"
          },
          "scenarios": {
            "$ref": "#/$defs/references"
          }
        },
        "required": [
          "requirement",
          "specifications",
          "scenarios"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "amendment": {
      "type": "object",
      "properties": {
        "requirements": {
          "$ref": "#/$defs/optional_references"
        },
        "paths": {
          "$ref": "#/$defs/optional_texts"
        },
        "rationale": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        }
      },
      "required": [
        "requirements",
        "paths",
        "rationale"
      ],
      "additionalProperties": false
    },
    "author_sessions": {
      "$ref": "#/$defs/references"
    },
    "solution_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/reference"
          },
          "kind": {
            "type": "string",
            "enum": [
              "subdomain",
              "operation",
              "invariant",
              "enabling"
            ]
          },
          "requirements": {
            "$ref": "#/$defs/references"
          },
          "scenarios": {
            "$ref": "#/$defs/references"
          },
          "specifications": {
            "$ref": "#/$defs/texts"
          },
          "module": {
            "$ref": "#/$defs/nullable_text"
          },
          "behavior": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "support"
            ]
          },
          "contract_operations": {
            "$ref": "#/$defs/texts"
          }
        },
        "required": [
          "id",
          "kind",
          "requirements",
          "scenarios",
          "specifications",
          "module",
          "behavior"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "target_tree": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          },
          "owner": {
            "$ref": "#/$defs/reference"
          },
          "purpose": {
            "$ref": "#/$defs/explanation"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "retain",
              "add",
              "modify",
              "delete",
              "generated"
            ]
          }
        },
        "required": [
          "path",
          "kind",
          "owner",
          "purpose",
          "disposition"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/reference"
          },
          "kind": {
            "type": "string",
            "enum": [
              "tool",
              "repository",
              "host",
              "external"
            ]
          },
          "path": {
            "$ref": "#/$defs/nullable_text"
          },
          "version": {
            "$ref": "#/$defs/nullable_text"
          },
          "probe_check_ids": {
            "$ref": "#/$defs/optional_references"
          },
          "environments": {
            "$ref": "#/$defs/references"
          },
          "availability": {
            "type": "string",
            "enum": [
              "baseline",
              "implementation",
              "external"
            ]
          },
          "required_at": {
            "type": "string",
            "enum": [
              "specification",
              "preparation",
              "implementation"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "version",
          "probe_check_ids",
          "environments",
          "availability",
          "required_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/reference"
          },
          "platform": {
            "type": "string",
            "enum": [
              "linux",
              "macos",
              "windows"
            ]
          },
          "host_profile": {
            "$ref": "#/$defs/nullable_text"
          }
        },
        "required": [
          "id",
          "platform",
          "host_profile"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "contract_index_path": {
      "$ref": "#/$defs/text"
    },
    "shared_generated_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/text"
          },
          "purpose": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        },
        "required": [
          "path",
          "purpose"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "domain_inventory": {
      "type": "object",
      "properties": {
        "path": {
          "const": "docs/specs/domain-inventory.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "s1_output_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256",
        "s1_output_digest"
      ],
      "additionalProperties": false
    },
    "boundary_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "interaction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "operations": {
            "$ref": "#/$defs/optional_texts"
          },
          "types": {
            "$ref": "#/$defs/optional_texts"
          },
          "exports": {
            "$ref": "#/$defs/optional_texts"
          }
        },
        "required": [
          "interaction",
          "operations",
          "types"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "requirements_digest",
    "mode",
    "parent_spec_digest",
    "change_summary",
    "documents",
    "decisions",
    "contract_files",
    "generated_files",
    "contract_check_ids",
    "project_check_ids",
    "modules",
    "scenarios",
    "checks",
    "requirement_map",
    "amendment",
    "author_sessions",
    "solution_elements",
    "target_tree",
    "resources",
    "environments",
    "contract_index_path",
    "shared_generated_files",
    "domain_inventory",
    "boundary_bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "references": {
      "$ref": "#/$defs/optional_references",
      "minItems": 1
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "texts": {
      "$ref": "#/$defs/optional_texts",
      "minItems": 1
    },
    "optional_references": {
      "$ref": "#/$defs/optional_texts",
      "items": {
        "maxLength": 80
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "optional_texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "nullable_text": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
